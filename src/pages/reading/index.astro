---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const entries = (await getCollection('reading', ({data}) => data.published)).sort((a,b)=>a.data.displayOrder-b.data.displayOrder||a.data.title.localeCompare(b.data.title));
---
<BaseLayout title="Reading & Indie Authors" description="Books I'm reading and independent authors I want to share."><section class="section"><div class="wrap"><div class="eyebrow">Beyond my bookshelf</div><h1>Reading & Indie Authors</h1><p class="lead">Books I'm exploring, plus writers whose work deserves a closer look.</p>{entries.length ? <div class="reading-grid">{entries.map(entry=><article class="card reading-entry">{entry.data.cover && <img src={entry.data.cover} alt={`Cover of ${entry.data.title}`} loading="lazy"/>}<div><span class="tag">{entry.data.status}{entry.data.genre ? ` · ${entry.data.genre}` : ''}</span><h2>{entry.data.title}</h2><p class="byline">by {entry.data.author}</p>{entry.data.description && <p>{entry.data.description}</p>}{entry.data.myThoughts && <p><strong>My thoughts:</strong> {entry.data.myThoughts}</p>}<div class="links">{entry.data.bookUrl && <a href={entry.data.bookUrl} target="_blank" rel="noopener noreferrer">Find the book ↗</a>}{entry.data.authorUrl && <a href={entry.data.authorUrl} target="_blank" rel="noopener noreferrer">Visit the author ↗</a>}</div></div></article>)}</div> : <p class="empty">Recommendations will appear here once I add them.</p>}</div></section></BaseLayout>
<style>.reading-grid{display:grid;gap:20px;margin-top:34px}.reading-entry{display:flex;align-items:flex-start;gap:25px}.reading-entry img{width:145px;max-width:34%;aspect-ratio:2/3;object-fit:cover;flex:0 0 auto}.reading-entry h2{font-size:1.55rem;margin:10px 0}.reading-entry p{color:var(--muted)}.byline{font-style:italic}.links{display:flex;gap:20px;flex-wrap:wrap}.links a{color:var(--copper)}@media(max-width:550px){.reading-entry{flex-direction:column}}</style>
