---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getCollection} from 'astro:content';
const products=await getCollection('products',({data})=>data.published);
---
<BaseLayout title="Shop"><section class="section"><div class="wrap"><div class="eyebrow">The shop</div><h1>Books & beyond.</h1><p class="lead">Explore books, editions, and creator merchandise. Choose the retailer that works best for you.</p><div class="grid">{products.map(product=><article class="card">{product.data.image&&<img src={product.data.image} alt="" loading="lazy"/>}<span class="tag">{product.data.category}</span><h3>{product.data.title}</h3><p>{product.data.description}</p><div class="product-links">{product.data.amazonUrl&&<a class="pill" href={product.data.amazonUrl} target="_blank" rel="noopener noreferrer sponsored">Amazon ↗</a>}{product.data.payhipUrl&&<a class="pill" href={product.data.payhipUrl} target="_blank" rel="noopener noreferrer">Payhip ↗</a>}{product.data.otherUrl&&<a class="pill" href={product.data.otherUrl} target="_blank" rel="noopener noreferrer">{product.data.otherLabel||'Other retailer'} ↗</a>}</div></article>)}</div>{!products.length&&<p class="empty">Product listings will appear here when you add them in the editor.</p>}<p style="color:var(--muted);font-size:.85rem;margin-top:30px">Purchases are processed by the linked retailer, not on this website. If we add affiliate links, required disclosures will be shown here.</p></div></section></BaseLayout>
