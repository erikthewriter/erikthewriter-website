---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getCollection} from 'astro:content';
const books=await getCollection('books',({data})=>data.published);
const bookIds=new Set(books.map(book=>book.id));
const products=(await getCollection('products',({data})=>data.published)).filter(product=>!bookIds.has(product.id));
const validUrl=(url:unknown)=>typeof url==='string' && /^https?:\/\//i.test(url);
const formatPrice=(amount:number)=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(amount);
---
<BaseLayout title="Shop"><section class="section"><div class="wrap"><div class="eyebrow">The shop</div><h1>Books & beyond.</h1><p class="lead">Explore books, editions, and creator merchandise. Choose the retailer that works best for you.</p><div class="grid">{books.map(book=><article class="card">{book.data.cover&&<img src={book.data.cover} alt={`Cover of ${book.data.title}`} loading="lazy"/>}<span class="tag">Book</span><h3>{book.data.title}</h3><p>{book.data.description}</p><p><a href={`/writing/books/${book.id}/`}>View book and editions →</a></p>{book.data.editions.length>0&&<div class="edition-summary">{book.data.editions.map(edition=><div class="edition-row"><strong>{edition.format}</strong>{edition.price!==undefined&&<span>{formatPrice(edition.price)}</span>}<small>{edition.availability}</small><div class="product-links">{edition.retailers.filter(r=>validUrl(r.url)).map(r=><a class="pill" href={r.url} target="_blank" rel="noopener noreferrer">{r.name} ↗</a>)}</div></div>)}</div>}</article>)}{products.map(product=><article class="card">{product.data.image&&<img src={product.data.image} alt="" loading="lazy"/>}<span class="tag">{product.data.category}</span><h3>{product.data.title}</h3><p>{product.data.description}</p><div class="product-links">{product.data.amazonUrl&&<a class="pill" href={product.data.amazonUrl} target="_blank" rel="noopener noreferrer sponsored">Amazon ↗</a>}{product.data.payhipUrl&&<a class="pill" href={product.data.payhipUrl} target="_blank" rel="noopener noreferrer">Payhip ↗</a>}{product.data.otherUrl&&<a class="pill" href={product.data.otherUrl} target="_blank" rel="noopener noreferrer">{product.data.otherLabel||'Other retailer'} ↗</a>}</div></article>)}</div>{!products.length&&!books.length&&<p class="empty">Product listings will appear here when you add them in the editor.</p>}<p style="color:var(--muted);font-size:.85rem;margin-top:30px">Purchases are processed by the linked retailer, not on this website. If we add affiliate links, required disclosures will be shown here.</p></div></section></BaseLayout>

<style>.edition-summary{display:grid;gap:12px;margin-top:14px}.edition-row{border-top:1px solid var(--line);padding-top:10px}.edition-row strong{margin-right:12px}.edition-row small{display:block;color:var(--muted);margin-top:3px}.edition-row .product-links{margin-top:7px}</style>
