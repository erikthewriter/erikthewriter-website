---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { dayOrder, niceTime, zoneLabels, niceDate, isUpcoming } from '../../lib/streamSchedule';
const weekly=(await getCollection('weeklyStreams')).filter(x=>x.data.published).sort((a,b)=>dayOrder.indexOf(a.data.day)-dayOrder.indexOf(b.data.day)||a.data.time.localeCompare(b.data.time)||a.data.displayOrder-b.data.displayOrder);
const events=(await getCollection('streamEvents')).filter(x=>x.data.published&&x.data.status!=='Completed'&&(isUpcoming(x.data.date,x.data.time,x.data.timezone)||x.data.status==='Postponed')).sort((a,b)=>`${a.data.date}${a.data.time}`.localeCompare(`${b.data.date}${b.data.time}`));
---
<BaseLayout title="Streaming"><section class="hero"><div class="wrap"><div class="eyebrow">The streaming</div><h1>The Library<br/><span style="color:var(--copper)">is open.</span></h1><p class="lead">Gaming, stories, collaborations, and a welcoming community. Browse the weekly schedule, upcoming events, and my Steam game library below.</p><div class="actions"><a class="btn" href="https://www.twitch.tv/erikthewriter" target="_blank" rel="noopener noreferrer">Watch on Twitch ↗</a><a class="btn outline" href="/media/">Watch Highlights</a><a class="btn outline" href="/streaming/games/">Browse My Games</a></div></div></section>
<section class="section"><div class="wrap"><div class="section-heading"><div><div class="eyebrow">Regular programming</div><h2>Weekly schedule</h2></div></div>
{weekly.length?<div class="grid two">{weekly.map(item=><article class="card"><div class="tag">{item.data.day} · {niceTime(item.data.time)} {zoneLabels[item.data.timezone]||item.data.timezone}</div><h3>{item.data.title}</h3>{item.data.game&&<p><strong>{item.data.game}</strong></p>}<p>{item.data.description}</p>{item.data.status!=='Scheduled'&&<p class="event-state">{item.data.status}</p>}</article>)}</div>:<div class="empty">Weekly streaming times will be announced here.</div>}
</div></section><section class="section alt"><div class="wrap"><div class="section-heading"><div><div class="eyebrow">Mark your calendar</div><h2>Upcoming events</h2></div></div>
{events.length?<div class="grid two">{events.map(item=><article class="card">{item.data.image&&<img src={item.data.image} alt="" loading="lazy"/>}<div class="tag">{niceDate(item.data.date)} · {niceTime(item.data.time)} {zoneLabels[item.data.timezone]||item.data.timezone}</div><h3><a href={`/streaming/events/${item.id}/`}>{item.data.title}</a></h3>{item.data.game&&<p>{item.data.game}</p>}<p>{item.data.description}</p>{item.data.status!=='Scheduled'&&<p class="event-state">{item.data.status}</p>}<a href={`/streaming/events/${item.id}/`}>Event details →</a></article>)}</div>:<div class="empty">No upcoming events are listed yet. Check back soon.</div>}
</div></section><section class="section"><div class="wrap"><div class="grid two"><article class="card"><div class="eyebrow">Live on Twitch</div><h2>EriktheWriter</h2><p>Catch the streams and previous broadcasts on Twitch.</p><a href="https://www.twitch.tv/erikthewriter" target="_blank" rel="noopener noreferrer">Open Twitch ↗</a></article><article class="card"><div class="eyebrow">Community</div><h2>The Haunted Library</h2><p>Readers, gamers, collaborators, and friends. Verified community invitations will be added here.</p></article></div></div></section></BaseLayout>
<style>.event-state{color:var(--copper)!important;font-weight:700}.card h3 a{text-decoration:none}.card h3 a:hover{color:var(--copper)}</style>
