---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import steamGames from '../../../data/steam-games.json';
import { getCollection } from 'astro:content';
const notes=await getCollection('gameNotes');
const byId=new Map(notes.map(n=>[n.data.appid,n.data]));
const games=steamGames.map(game=>({
 ...game,
 rating:byId.get(game.appid)?.rating ?? null,
 playStatus:byId.get(game.appid)?.playStatus ?? 'Unspecified',
 wantToPlay:byId.get(game.appid)?.wantToPlay ?? false,
 lookingForPlayers:byId.get(game.appid)?.lookingForPlayers ?? 'Not actively looking',
 streaming:byId.get(game.appid)?.streaming ?? 'Not currently',
 collabPreference:byId.get(game.appid)?.collabPreference ?? 'No preference',
 featured:byId.get(game.appid)?.featured ?? false,
 genres:byId.get(game.appid)?.genres ?? [],
 modes:byId.get(game.appid)?.modes ?? [],
 players:byId.get(game.appid)?.players ?? '',
 review:byId.get(game.appid)?.review ?? '',
}));
---
<BaseLayout title="Game Library" description="Browse EriktheWriter's Steam game library, favorites, and games he's looking to play.">
<section class="hero"><div class="wrap"><div class="eyebrow">The Streaming Collection</div><h1>The Game<br/><span style="color:var(--copper)">Library.</span></h1><p class="lead">Explore my Steam games, see what I'm streaming or hoping to play, and find something we might enjoy together.</p><div class="actions"><a class="btn outline" href="/streaming/">← Streaming home</a><a class="btn outline" href="https://steamcommunity.com/profiles/76561198263149204/" target="_blank" rel="noopener noreferrer">Steam profile ↗</a></div></div></section>
<section class="section"><div class="wrap"><div class="library-summary"><div><strong>{games.length}</strong><span>Steam titles imported</span></div><div><strong>{games.filter(x=>x.rating!==null).length}</strong><span>Personally rated</span></div><div><strong>{games.filter(x=>x.lookingForPlayers==='Actively looking').length}</strong><span>Actively looking to play</span></div></div><p class="library-note">My ratings and preferences are personal opinions, never restrictions. You're welcome to suggest <strong>any</strong> game—even one I rated 0/10. You can request any game, regardless of my rating or whether I'm actively playing it. Submitting a request does not guarantee a collaboration.</p>
<div class="controls"><label class="input-group">Search by title<input id="gameSearch" type="search" placeholder="Search all games…" autocomplete="off"/></label><label class="input-group">My rating<select id="ratingFilter"><option value="all">Any rating</option><option value="rated">Rated only</option><option value="unrated">Unrated</option><option value="8">8 or higher</option><option value="6">6 or higher</option><option value="4">4 or higher</option></select></label><label class="input-group">Play status<select id="playFilter"><option value="all">All statuses</option><option value="Never played">Never played</option><option value="Played">Played</option><option value="Currently playing">Currently playing</option><option value="Completed">Completed</option><option value="Abandoned">Abandoned</option><option value="Unspecified">Not set yet</option></select></label><label class="input-group">Activity<select id="activityFilter"><option value="all">All games</option><option value="looking">Looking for players</option><option value="want">Want to play</option><option value="streaming">Streaming regularly / occasionally</option><option value="featured">Featured</option></select></label><label class="input-group">Genre<select id="genreFilter"><option value="all">All genres</option>{[...new Set(games.flatMap(g=>g.genres))].sort().map(v=><option value={v}>{v}</option>)}</select></label><label class="input-group">Play mode<select id="modeFilter"><option value="all">Any play mode</option>{[...new Set(games.flatMap(g=>g.modes))].sort().map(v=><option value={v}>{v}</option>)}</select></label><label class="input-group">Sort<select id="sortFilter"><option value="name">Title A–Z</option><option value="rating">My rating high–low</option><option value="featured">Featured first</option></select></label></div>
<div class="result-bar"><span id="resultCount">{games.length} games</span><button id="resetFilters" type="button">Clear filters</button></div>
<div class="game-grid" id="gameGrid">{games.map(game=><article class="game-card" data-name={game.name.toLocaleLowerCase()} data-rating={game.rating===null?'':String(game.rating)} data-play={game.playStatus} data-looking={game.lookingForPlayers} data-want={String(game.wantToPlay)} data-streaming={game.streaming} data-featured={String(game.featured)} data-genres={JSON.stringify(game.genres)} data-modes={JSON.stringify(game.modes)}>
<a class="game-art" href={`https://store.steampowered.com/app/${game.appid}/`} target="_blank" rel="noopener noreferrer" aria-label={`View ${game.name} on Steam`}><img src={`https://cdn.cloudflare.steamstatic.com/steam/apps/${game.appid}/header.jpg`} alt="" loading="lazy" onerror="this.style.display='none'"/></a><div class="game-main"><div class="game-top"><h2>{game.name}</h2><span class="game-rating">{game.rating===null?'Unrated':`${game.rating.toFixed(2).replace(/\.00$/,'')} / 10`}</span></div><p class="game-tags">{game.genres.length?game.genres.join(' · '):'Genre not yet tagged'}{game.modes.length?' · '+game.modes.join(' / '):''}{game.players?' · '+game.players+' players':''}</p><div class="game-flags">{game.featured&&<span class="flag">Featured</span>}{game.lookingForPlayers==='Actively looking'&&<span class="flag hot">Looking for players</span>}{game.wantToPlay&&<span class="flag">Want to play</span>}{game.streaming!=='Not currently'&&<span class="flag">Streams {game.streaming.toLowerCase()}</span>}{game.playStatus!=='Unspecified'&&<span class="flag subtle">{game.playStatus}</span>}</div>{game.review&&<p class="review">{game.review}</p>}<div class="game-bottom"><span>Steam ID: {game.appid}</span><button class="requestGame" type="button" data-appid={game.appid} data-title={game.name}>Request a Collab</button></div></div></article>)}</div><div id="nothingFound" class="empty" hidden>No games match these filters. Try clearing one or more filters.</div>
</div></section>

<dialog id="collabDialog" aria-labelledby="collabHeading">
 <form id="collabForm" novalidate>
  <div class="modal-header"><div><div class="eyebrow">The Library · Let's Play</div><h2 id="collabHeading">Request a Collab</h2></div><button type="button" id="closeCollab" aria-label="Close dialog">×</button></div>
  <p class="modal-intro">Request <strong id="selectedGameName"></strong> for a stream or a casual game night. No pressure and no commitment until we've talked.</p>
  <input type="hidden" name="appid" id="requestAppid"/>
  <label class="modal-field">Play together<select name="requestType" required><option value="on-stream">On-stream collaboration</option><option value="off-stream">Off-stream gaming</option><option value="either">Either works for me</option></select></label>
  <div class="modal-two"><label class="modal-field">Contact me through<select name="contactPlatform" required><option value="Discord">Discord</option><option value="Twitch">Twitch</option></select></label><label class="modal-field">Your username<input name="contactHandle" required minlength="2" maxlength="80" autocomplete="off" placeholder="Your Discord or Twitch username"/></label></div>
  <label class="modal-field">Timing<select name="timing" id="collabTiming"><option value="flexible">Whenever works · No rush</option><option value="specific">I have a date in mind</option><option value="discuss">Let's work something out</option></select></label>
  <label class="modal-field" id="specificDateField" hidden>Preferred date<input type="date" name="preferredDate" id="collabDate"/></label>
  <label class="modal-field">Message (optional)<textarea name="message" maxlength="1500" rows="4" placeholder="For example: I'm running this on the 25th and would love for you to join, or next time you stream it would be great!"></textarea></label>
  <div id="collabTurnstile" class="captcha-slot"></div>
  <p class="form-notice">Your contact details and message are sent privately for reviewing this request. They won't appear publicly. A request is not an accepted invitation.</p>
  <p role="status" aria-live="polite" id="collabResponse"></p>
  <button type="submit" class="collabSubmit">Send Request</button>
 </form>
</dialog>
</BaseLayout>
<script>
const search=document.querySelector<HTMLInputElement>('#gameSearch')!;
const inputs=['ratingFilter','playFilter','activityFilter','genreFilter','modeFilter','sortFilter'].map(id=>document.getElementById(id) as HTMLSelectElement);
const [rating,play,activity,genre,mode,sort]=inputs;
const cards=[...document.querySelectorAll<HTMLElement>('.game-card')];
const count=document.getElementById('resultCount')!;
const empty=document.getElementById('nothingFound')!;
const container=document.getElementById('gameGrid')!;
function update(){let visible=0;
 for(const card of cards){const data=card.dataset;const n=data.rating===''?null:Number(data.rating);const matches=(!search.value.trim()||data.name?.includes(search.value.trim().toLocaleLowerCase()))&&(rating.value==='all'||(rating.value==='unrated'?n===null:rating.value==='rated'?n!==null:n!==null&&n>=Number(rating.value)))&&(play.value==='all'||data.play===play.value)&&(activity.value==='all'||(activity.value==='looking'?data.looking==='Actively looking':activity.value==='want'?data.want==='true':activity.value==='featured'?data.featured==='true':data.streaming!=='Not currently'))&&(genre.value==='all'||JSON.parse(data.genres||'[]').includes(genre.value))&&(mode.value==='all'||JSON.parse(data.modes||'[]').includes(mode.value));card.hidden=!matches;if(matches)visible++; }
 const ordered=[...cards].sort((a,b)=>sort.value==='rating'?(Number(b.dataset.rating||-1)-Number(a.dataset.rating||-1)||a.dataset.name!.localeCompare(b.dataset.name!)):sort.value==='featured'?(Number(b.dataset.featured==='true')-Number(a.dataset.featured==='true')||a.dataset.name!.localeCompare(b.dataset.name!)):a.dataset.name!.localeCompare(b.dataset.name!));for(const c of ordered)container.append(c);count.textContent=`${visible} of ${cards.length} games`;empty.hidden=visible>0;
}
search.addEventListener('input',update);for(const el of inputs)el.addEventListener('change',update);
document.getElementById('resetFilters')?.addEventListener('click',()=>{search.value='';for(const el of inputs)el.value=el.id==='sortFilter'?'name':'all';update()});update();


const dialog=document.querySelector<HTMLDialogElement>('#collabDialog')!;
const form=document.querySelector<HTMLFormElement>('#collabForm')!;
const status=document.getElementById('collabResponse')!;
const timing=document.querySelector<HTMLSelectElement>('#collabTiming')!;
const dateField=document.getElementById('specificDateField')!;
const preferredDate=document.querySelector<HTMLInputElement>('#collabDate')!;
const siteKey=import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
let widgetId:string|undefined;
declare global { interface Window { turnstile?: { render:(container:string, options:Record<string,unknown>)=>string; reset:(id?:string)=>void; remove:(id:string)=>void }; } }
function updateDate(){dateField.hidden=timing.value!=='specific';preferredDate.required=timing.value==='specific';if(!preferredDate.required)preferredDate.value='';}
timing.addEventListener('change',updateDate);
function renderCaptcha(){if(!siteKey || !window.turnstile || widgetId!==undefined) return;widgetId=window.turnstile.render('#collabTurnstile',{sitekey:siteKey,theme:'dark'});}
const turnstileScript=document.createElement('script');turnstileScript.src='https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';turnstileScript.async=true;turnstileScript.defer=true;turnstileScript.onload=renderCaptcha;document.head.append(turnstileScript);
for(const button of document.querySelectorAll<HTMLButtonElement>('.requestGame')){button.addEventListener('click',()=>{form.reset();widgetId!==undefined&&window.turnstile?.reset(widgetId);status.textContent='';document.getElementById('requestAppid')!.setAttribute('value',button.dataset.appid||'');(document.getElementById('requestAppid') as HTMLInputElement).value=button.dataset.appid||'';document.getElementById('selectedGameName')!.textContent=button.dataset.title||'';updateDate();dialog.showModal();renderCaptcha();});}
document.getElementById('closeCollab')!.addEventListener('click',()=>dialog.close());
dialog.addEventListener('click',event=>{if(event.target===dialog) dialog.close();});
form.addEventListener('submit',async event=>{event.preventDefault();if(!form.reportValidity())return;const button=form.querySelector<HTMLButtonElement>('.collabSubmit')!;if(!siteKey){status.textContent='Requests are not enabled yet. Please check back shortly.';return;}button.disabled=true;status.textContent='Sending your request…';try{const fields=new FormData(form);const payload=Object.fromEntries(fields.entries());payload['turnstileToken']=String(fields.get('cf-turnstile-response')||'');const response=await fetch('/api/collab-request',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});const result=await response.json();if(!response.ok)throw new Error(result.error||'Could not send request.');status.textContent='Request received! I’ll reach out if we can make it happen.';form.reset();updateDate();if(widgetId!==undefined)window.turnstile?.reset(widgetId);}catch(error){status.textContent=error instanceof Error?error.message:'Request failed. Please try again.';if(widgetId!==undefined)window.turnstile?.reset(widgetId);}finally{button.disabled=false;}});
</script>
<style>
.library-summary{display:flex;gap:28px;flex-wrap:wrap;margin-bottom:25px}.library-summary div{min-width:145px}.library-summary strong{display:block;font-size:2rem;color:var(--copper);line-height:1.1}.library-summary span{font-size:.82rem;color:var(--muted)}.library-note{border-left:3px solid var(--copper);background:var(--panel);padding:15px 19px;color:var(--muted);margin:10px 0 29px}.library-note strong{color:var(--text)}.controls{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px;margin-bottom:22px}.input-group{font-size:.77rem;font-weight:bold;color:var(--gold);display:flex;flex-direction:column;gap:6px}.input-group input,.input-group select{width:100%;padding:11px;background:var(--panel);border:1px solid #6a5b50;border-radius:4px;color:var(--text);font:inherit;font-weight:normal;font-size:.9rem}.input-group input:focus,.input-group select:focus{outline:2px solid var(--copper)}.result-bar{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;color:var(--muted);font-size:.87rem}.result-bar button{border:0;background:none;color:var(--copper);cursor:pointer;text-decoration:underline}.game-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.game-card{display:flex;flex-direction:column;border:1px solid var(--line);border-radius:7px;overflow:hidden;background:var(--panel);min-width:0}.game-card[hidden],#nothingFound[hidden]{display:none}.game-card:hover{border-color:#91623e}.game-art{height:128px;background:#181b1c;display:block;overflow:hidden}.game-art img{width:100%;height:100%;object-fit:cover}.game-main{padding:20px;display:flex;flex-direction:column;gap:8px;flex:1}.game-top{display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.game-top h2{font-size:1.08rem;margin:0}.game-rating{color:var(--gold);font-size:.77rem;white-space:nowrap}.game-tags{font-size:.77rem;color:var(--muted);margin:0}.game-flags{display:flex;gap:5px;flex-wrap:wrap}.flag{font-size:.68rem;border:1px solid #755b47;padding:3px 7px;color:#e8c9ab;border-radius:3px}.flag.hot{border-color:var(--copper);color:#ffc080;background:#54321e}.flag.subtle{border-color:#4d4b49;color:var(--muted)}.review{color:var(--muted);font-size:.84rem;margin:4px 0}.game-bottom{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:auto;padding-top:12px;border-top:1px solid var(--line)}.game-bottom span{font-size:.72rem;color:var(--muted)}.requestGame,.collabSubmit{background:var(--deep);color:#fff;border:1px solid var(--copper);border-radius:4px;padding:10px 13px;font-size:.8rem;font-weight:700;cursor:pointer}.requestGame:hover,.collabSubmit:hover{background:#ba6025}.collabSubmit:disabled{opacity:.5;cursor:wait}dialog#collabDialog{background:var(--panel);color:var(--text);width:min(580px,calc(100% - 24px));max-height:90vh;overflow:auto;border:1px solid #76563c;border-radius:10px;padding:26px}dialog#collabDialog::backdrop{background:#000b}.modal-header{display:flex;align-items:start;justify-content:space-between;gap:16px}.modal-header h2{font-size:1.45rem;margin:6px 0}.modal-header button{border:none;background:transparent;color:var(--text);font-size:2rem;cursor:pointer}.modal-intro{font-size:.86rem;color:var(--muted)}.modal-field{display:flex;flex-direction:column;gap:5px;color:var(--gold);font-size:.82rem;font-weight:700;margin:13px 0}.modal-field input,.modal-field select,.modal-field textarea{font:400 .92rem DM Sans,Arial,sans-serif;color:var(--text);background:#17191b;border:1px solid #67584c;border-radius:4px;padding:11px;max-width:100%}.modal-two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.modal-field[hidden]{display:none}.form-notice{font-size:.75rem;color:var(--muted)}.captcha-slot{min-height:65px}#collabResponse{font-size:.88rem;min-height:1.5em;color:var(--gold)}.collabSubmit{width:100%;font-size:.95rem}@media(max-width:550px){.modal-two{grid-template-columns:1fr}}@media(max-width:850px){.controls{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:620px){.controls,.game-grid{grid-template-columns:1fr}.game-art{height:155px}.game-bottom{flex-wrap:wrap}}
</style>
