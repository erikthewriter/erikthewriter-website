---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {getCollection} from 'astro:content';
import {parseTwitchMedia} from '../../../lib/twitchMedia';
const videos=(await getCollection('literaryQa',({data})=>data.published))
  .map(item=>({...item,twitch:parseTwitchMedia(item.data.twitchUrl)}))
  .sort((a,b)=>a.data.displayOrder-b.data.displayOrder||a.data.title.localeCompare(b.data.title));
const categories=[...new Set(videos.map(item=>item.data.category.trim()).filter(Boolean))].sort();
---
<BaseLayout title="The Writer's Desk — Literary Q&A" description="Search literary Q&A videos from Erik the Writer's Twitch streams by question, viewer, category, and tag.">
<section class="section"><div class="wrap">
  <div class="eyebrow">The Writer's Desk</div><h1>Literary Q&A</h1>
  <p class="lead">Conversations about fiction, characters, worldbuilding, and the writing process — answered live on Twitch.</p>
  {videos.length>0 && <div class="qa-tools"><label class="qa-search-label" for="qa-search">Search questions, topics, tags, or who asked</label><input id="qa-search" type="search" placeholder="Try Ward, writing craft, or a viewer's name…" autocomplete="off"/><div class="qa-filters" role="group" aria-label="Filter discussion category"><button class="category active" type="button" data-category="" aria-pressed="true">All topics</button>{categories.map(category=><button class="category" type="button" data-category={category} aria-pressed="false">{category}</button>)}</div><p class="result-count" id="qa-count" aria-live="polite"></p></div>}
  <div class="qa-grid" id="qa-list">{videos.map(({id,data,twitch})=><article class="card qa-card" id={`qa-${id}`} data-title={data.title.toLowerCase()} data-asker={data.askedBy.toLowerCase()} data-description={data.description.toLowerCase()} data-category={data.category.toLowerCase()} data-tags={JSON.stringify(data.tags.map(t=>t.toLowerCase()))}>
    <div class="video-frame" data-embed-type={twitch?.type||''} data-embed-id={twitch?.id||''} data-spoilers={String(data.spoilers)}>
      {data.spoilers?<div class="video-gate"><strong>Contains spoilers</strong><span>This conversation may reveal plot details.</span><button type="button" class="play-video">Reveal &amp; play video</button></div>:<div class="video-gate"><span>Watch the Twitch discussion</span><button type="button" class="play-video">Load video</button></div>}
    </div>
    <div class="qa-details"><div class="eyebrow">{data.category}{data.spoilers?' · Spoilers':''}</div><h2>{data.title}</h2>{data.askedBy&&<p class="asked">Asked by <strong>{data.askedBy}</strong></p>}{data.description&&<p>{data.description}</p>}
      {data.tags.length>0&&<div class="tags" aria-label="Discussion tags">{data.tags.map(tag=><button type="button" class="qa-tag" data-tag={tag.toLowerCase()}>#{tag}</button>)}</div>}
      <a class="original-link" href={data.twitchUrl} target="_blank" rel="noopener noreferrer">Watch directly on Twitch ↗</a>
    </div>
  </article>)}</div>
  {videos.length===0&&<p class="empty">The literary Q&A archive is being prepared. Check back for the first conversation.</p>}
  {videos.length>0&&<p class="empty" id="qa-no-match" hidden>No conversations match those search terms. Try a different tag, name, or topic.</p>}
</div></section></BaseLayout>
<style>
.qa-tools{margin:32px 0 24px}.qa-search-label{display:block;color:var(--muted);font-size:.9rem;margin-bottom:8px}#qa-search{background:var(--panel);border:1px solid var(--line);color:var(--text);border-radius:5px;width:100%;max-width:680px;padding:13px 15px;font:inherit}#qa-search:focus{outline:2px solid var(--copper)}.qa-filters{display:flex;flex-wrap:wrap;gap:8px;margin-top:16px}.category,.qa-tag{font:inherit;cursor:pointer;border:1px solid var(--line);background:var(--panel);color:var(--muted);border-radius:4px;padding:7px 11px}.category.active,.category:hover,.qa-tag:hover{border-color:var(--copper);color:var(--text)}.result-count{color:var(--muted);font-size:.84rem}.qa-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px}.qa-card{padding:0;overflow:hidden;scroll-margin-top:110px}.video-frame{background:#0c0d0e;aspect-ratio:16/9;min-height:240px;position:relative;overflow:hidden}.video-gate{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;text-align:center;padding:15px;color:var(--text)}.video-gate span{font-size:.85rem;color:var(--muted)}.play-video{cursor:pointer;background:var(--deep);border:1px solid var(--copper);color:white;border-radius:4px;font-weight:700;padding:9px 15px}.video-frame :global(iframe){position:absolute;inset:0;display:block;width:100%;height:100%;border:0}.qa-details{padding:23px}.qa-details h2{font-size:1.32rem;margin:8px 0 12px}.qa-details p{color:var(--muted)}.qa-details .asked{font-size:.88rem}.tags{display:flex;gap:7px;flex-wrap:wrap;margin:16px 0}.qa-tag{font-size:.77rem;padding:5px 8px}.original-link{display:inline-block;color:var(--copper);font-size:.88rem;margin-top:10px}.qa-card[hidden],#qa-no-match[hidden]{display:none!important}@media(max-width:820px){.qa-grid{grid-template-columns:1fr}}@media(max-width:520px){.video-frame{min-height:210px}}
</style>
<script>
 const search=document.querySelector<HTMLInputElement>('#qa-search');
 const buttons=[...document.querySelectorAll<HTMLButtonElement>('.category')];
 const cards=[...document.querySelectorAll<HTMLElement>('.qa-card')];
 const count=document.querySelector<HTMLElement>('#qa-count');
 const noMatch=document.querySelector<HTMLElement>('#qa-no-match');
 let selected='';
 const normalize=(v:string)=>v.trim().toLocaleLowerCase();
 function filter(){const term=normalize(search?.value||'');let shown=0;cards.forEach(card=>{const category=card.dataset.category||'';const content=[card.dataset.title,card.dataset.asker,card.dataset.description,category,card.dataset.tags].join(' ');const visible=(!selected||category===selected)&&(!term||content.includes(term));card.hidden=!visible;if(visible)shown++;});if(count)count.textContent=`Showing ${shown} of ${cards.length} conversations`;if(noMatch)noMatch.hidden=shown!==0;}
 search?.addEventListener('input',filter);
 buttons.forEach(button=>button.addEventListener('click',()=>{selected=normalize(button.dataset.category||'');buttons.forEach(b=>{const active=b===button;b.classList.toggle('active',active);b.setAttribute('aria-pressed',String(active))});filter()}));
 document.querySelectorAll<HTMLButtonElement>('.qa-tag').forEach(button=>button.addEventListener('click',()=>{if(search)search.value=button.dataset.tag||'';selected='';buttons.forEach(b=>{const active=!b.dataset.category;b.classList.toggle('active',active);b.setAttribute('aria-pressed',String(active))});filter();search?.focus();window.scrollTo({top:Math.max(0,(search?.getBoundingClientRect().top||0)+window.scrollY-125),behavior:'smooth'});}));
 document.querySelectorAll<HTMLButtonElement>('.play-video').forEach(button=>button.addEventListener('click',()=>{const frame=button.closest<HTMLElement>('.video-frame');if(!frame)return;const type=frame.dataset.embedType,id=frame.dataset.embedId||'';if(!/^[a-z0-9_-]+$/i.test(id))return;const params=new URLSearchParams({parent:window.location.hostname,autoplay:'false'});let src='';if(type==='clip'){params.set('clip',id);src='https://clips.twitch.tv/embed?'+params.toString()}else if(type==='vod'&&/^\d+$/.test(id)){params.set('video','v'+id);src='https://player.twitch.tv/?'+params.toString()}else return;const iframe=document.createElement('iframe');iframe.src=src;iframe.title='Twitch literary Q&A video';iframe.allow='fullscreen; autoplay; picture-in-picture';iframe.allowFullscreen=true;iframe.referrerPolicy='strict-origin-when-cross-origin';frame.replaceChildren(iframe);}));
 filter();
</script>
