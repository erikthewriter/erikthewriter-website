---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getCollection} from 'astro:content';
const series=(await getCollection('series',({data})=>data.published)).sort((a,b)=>a.data.order-b.data.order);
const books=(await getCollection('books',({data})=>data.published)).sort((a,b)=>Number(b.data.featured)-Number(a.data.featured)||a.data.title.localeCompare(b.data.title));
---
<BaseLayout title="Writing"><section class="hero"><div class="wrap"><div class="eyebrow">The writing</div><h1>Every story leaves<br/><span style="color:var(--copper)">a mark.</span></h1><p class="lead">Novels, imagined worlds, and the craft of bringing them to life.</p><div class="actions"><a class="btn" href="#books">Explore books</a><a class="btn outline" href="/journal/">Read the journal</a></div></div></section>
<section class="section"><div class="wrap"><div class="section-heading"><div><div class="eyebrow">Explore the worlds</div><h2>Book series</h2></div></div>{series.length ? <div class="grid two">{series.map(item=><div class="card">{item.data.image&&<img src={item.data.image} alt="" loading="lazy"/>}<div class="eyebrow">{item.data.status}</div><h3>{item.data.title}</h3><p>{item.data.description}</p><a href={`/writing/series/${item.id}/`}>View series →</a></div>)}</div>:<div class="empty">Series details are being prepared.</div>}</div></section>
<section class="section alt" id="books"><div class="wrap"><div class="section-heading"><div><div class="eyebrow">The bookshelf</div><h2>Books</h2></div><a href="/shop/">Browse the combined shop →</a></div>{books.length?<div class="grid">{books.map(book=><div class="card">{book.data.cover&&<img src={book.data.cover} alt={`Cover art for ${book.data.title}`} loading="lazy"/>}<div class="eyebrow">{book.data.status}{book.data.seriesNumber?` · Book ${book.data.seriesNumber}`:''}</div><h3>{book.data.title}</h3><p>{book.data.description}</p><a href={`/writing/books/${book.id}/`}>Book details →</a></div>)}</div>:<div class="empty">Books will appear here when their entries are published.</div>}</div></section>
<section class="section"><div class="wrap"><div class="banner"><h3>The Writer's Journal</h3><p>Updates, process notes, behind-the-scenes stories, and occasional music experiments.</p><a href="/journal/" style="color:var(--copper)">Read journal entries →</a></div></div></section></BaseLayout>
