---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {getCollection,render} from 'astro:content';
export async function getStaticPaths(){return (await getCollection('books',({data})=>data.published)).map(book=>({params:{id:book.id},props:{book}}));}
const {book}=Astro.props;
const {Content}=await render(book);
const allSeries=await getCollection('series',({data})=>data.published);
const parent=allSeries.find(item=>item.id===book.data.series);
const validUrl=(url:unknown)=>typeof url==='string' && /^https?:\/\//i.test(url);
const editions=book.data.editions ?? [];
const legacyLinks=[{name:'Amazon',url:book.data.amazonUrl},{name:'Payhip',url:book.data.payhipUrl},{name:'Additional retailer',url:book.data.ingramUrl},{name:book.data.otherLabel||'Other retailer',url:book.data.otherUrl}].filter(x=>validUrl(x.url));
const formatPrice=(amount:number)=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD'}).format(amount);

---
<BaseLayout title={book.data.title} description={book.data.description}><section class="section"><div class="wrap"><a href="/writing/" style="color:var(--copper)">← All books</a><div class="book-hero"><div>{book.data.cover?<img class="cover" src={book.data.cover} alt={`Cover of ${book.data.title}`}/>:<div class="cover-placeholder">Cover artwork coming soon</div>}</div><div><div class="eyebrow">{book.data.status}{book.data.seriesNumber?` · Book ${book.data.seriesNumber}`:''}</div><h1>{book.data.title}</h1>{book.data.subtitle&&<h3>{book.data.subtitle}</h3>}<p class="lead">{book.data.description}</p>{parent&&<p>Part of <a href={`/writing/series/${parent.id}/`} style="color:var(--copper)">{parent.data.title}</a></p>}{book.data.releaseDate&&<p>Release: {book.data.releaseDate.toLocaleDateString('en-US',{dateStyle:'long'})}</p>}<h2 style="margin-top:2rem">Available editions</h2>{editions.length ? <div class="editions">{editions.map(edition=><section class="edition"><div class="edition-header"><h3>{edition.format}</h3><span class="edition-status">{edition.availability}</span></div>{edition.price !== undefined && <p class="edition-price">{formatPrice(edition.price)}</p>}{edition.isbn&&<p class="edition-isbn">ISBN: {edition.isbn}</p>}{edition.retailers.some(retailer=>validUrl(retailer.url))&&<div class="product-links">{edition.retailers.filter(retailer=>validUrl(retailer.url)).map(retailer=><a class="pill" href={retailer.url} target="_blank" rel="noopener noreferrer">Buy at {retailer.name} ↗</a>)}</div>}</section>)}</div> : legacyLinks.length ? <div class="product-links">{legacyLinks.map(link=><a class="pill" href={link.url} target="_blank" rel="noopener noreferrer">{link.name} ↗</a>)}</div> : <p>Retailer information will be added as editions become available.</p>}</div></div><article class="prose"><Content/></article><p style="color:var(--muted)">Purchases take place on external retailer websites.</p></div></section></BaseLayout>
<style>.book-hero{display:grid;grid-template-columns:minmax(170px,300px) 1fr;gap:40px;align-items:start;margin:30px 0 60px}.cover{width:100%;height:auto;border-radius:5px}.cover-placeholder{aspect-ratio:2/3;background:var(--panel);border:1px solid var(--line);display:grid;place-items:center;color:var(--muted);padding:25px;text-align:center}@media(max-width:650px){.book-hero{grid-template-columns:1fr}.book-hero>div:first-child{max-width:260px}}.editions{display:grid;gap:16px;margin-top:18px}.edition{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:18px 20px}.edition-header{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.edition h3{margin:0}.edition-status{color:var(--copper);font-size:.85rem}.edition-price{font-size:1.4rem;color:var(--text);margin:10px 0}.edition-isbn{color:var(--muted);font-size:.85rem}.edition .product-links{margin-top:15px}</style>
