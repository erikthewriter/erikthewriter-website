---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {getCollection} from 'astro:content';
const items=await getCollection('media',({data})=>data.published);
---
<BaseLayout title="Media"><section class="section"><div class="wrap"><div class="eyebrow">The media library</div><h1>Watch. Listen. Explore.</h1><p class="lead">Stream clips, songs, and videos gathered in one place.</p><div class="grid">{items.map(item=><article class="card">{item.data.image&&<img src={item.data.image} alt="" loading="lazy"/>}<span class="tag">{item.data.kind}</span><h3>{item.data.title}</h3><p>{item.data.description}</p>{item.data.url&&<a href={item.data.url} target="_blank" rel="noopener noreferrer">{item.data.kind==='Music'?'Listen':'Watch'} ↗</a>}</article>)}</div>{!items.length&&<p class="empty">Your media collection will appear here as soon as you add entries in the editor.</p>}</div></section></BaseLayout>
