---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const recent=(await getCollection('journal',({data})=>data.published)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<BaseLayout title="Home"><section class="hero"><div class="wrap"><div class="eyebrow">Fiction · Live Stories · Community</div><h1>Stories worth<br/><span style="color:var(--copper)">staying for.</span></h1><p class="lead">Welcome to the home of Erik the Writer. Explore the fiction, step behind the words, or join the community when the stream goes live.</p><div class="actions"><a class="btn" href="/writing/">Explore the Writing →</a><a class="btn outline" href="/streaming/">Visit the Stream</a></div></div></section><section class="section"><div class="wrap"><div class="section-heading"><div><div class="eyebrow">Two sides, one creator</div><h2>Find your way in.</h2></div></div><div class="grid two"><article class="card"><div class="eyebrow">01 / The Writing</div><h3>Worlds beyond the page.</h3><p>Discover the novels, ongoing series, writing journal, and the stories behind the stories.</p><a href="/writing/">Explore books and writing →</a></article><article class="card"><div class="eyebrow">02 / The Streaming</div><h3>Pull up a chair.</h3><p>Live gaming, ghost hunting, collaborations, and good company in The Haunted Library.</p><a href="/streaming/">Explore streaming →</a></article></div></div></section><section class="section alt"><div class="wrap"><div class="section-heading"><div><div class="eyebrow">Featured fiction</div><h2>No Survivors</h2></div><a href="/shop/">Find editions →</a></div><div class="banner"><p><strong>Day of the End · Book One.</strong> A survival-horror story where the end of the world may only be the beginning. Explore the series and available editions.</p></div></div></section><section class="section"><div class="wrap"><div class="section-heading"><div><div class="eyebrow">From the journal</div><h2>Recent entries</h2></div><a href="/journal/">All entries →</a></div>{recent.length?<div class="grid">{recent.map(post=><article class="card"><span class="tag">{post.data.category} · {post.data.date.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</span><h3>{post.data.title}</h3><p>{post.data.description}</p><a href={`/journal/${post.id}/`}>Read entry →</a></article>)}</div>:<p class="empty">Journal posts will appear here after you publish them through the editor.</p>}</div></section><section class="section alt"><div class="wrap"><div class="grid two"><article class="card"><div class="eyebrow">Watch & listen</div><h3>One media library.</h3><p>Streaming highlights, original songs, videos, and creative experiments together in one place.</p><a href="/media/">Explore media →</a></article><article class="card"><div class="eyebrow">Books & beyond</div><h3>A combined shop.</h3><p>Browse products here, then choose Amazon, Payhip, or another seller to complete your purchase.</p><a href="/shop/">Browse the shop →</a></article></div></div></section></BaseLayout>
