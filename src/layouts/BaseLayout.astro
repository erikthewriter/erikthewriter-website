---
import { getCollection } from 'astro:content';
const socialConfig = (await getCollection('socialLinks')).find(entry => entry.id === 'links')?.data;
const socialPlatforms = [
  ['Twitch', 'twitch'], ['Discord', 'discord'], ['YouTube', 'youtube'],
  ['Steam', 'steam'], ['Instagram', 'instagram'], ['Facebook', 'facebook'],
  ['TikTok', 'tiktok'], ['Bluesky', 'bluesky'], ['X', 'x'],
  ['Goodreads', 'goodreads'], ['Other', 'other']
] as const;
const socials = socialPlatforms.map(([label, key]) => ({label, url: socialConfig?.[key]?.trim() || ''}))
  .filter(item => /^https?:\/\/[^\s]+$/i.test(item.url));
const imprintLogo = '/uploads/eleven-candle-press-imprint.png';
const { title = 'Erik the Writer', description = 'The home of Erik the Writer: fiction, streaming, and creative work.' } = Astro.props;
const nav = [{name:'Home',url:'/'},{name:'Writing',url:'/writing/'},{name:'Streaming',url:'/streaming/'},{name:'Game Library',url:'/streaming/games/'},{name:'Reading',url:'/reading/'},{name:'Partners',url:'/partners/'},{name:'Journal',url:'/journal/'},{name:'Media',url:'/media/'},{name:'Shop',url:'/shop/'}];
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><title>{title} | Erik the Writer</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet"/></head>
<body><a class="skip" href="#content">Skip to content</a><header class="site-header"><div class="wrap header-content"><a class="brand" href="/">ERIK <span>THE WRITER</span><small>AUTHOR · STREAMER · STORYTELLER</small></a><nav aria-label="Main navigation">{nav.map(item=><a href={item.url} aria-current={Astro.url.pathname===item.url?'page':undefined}>{item.name}</a>)}</nav></div></header><main id="content"><slot/></main><footer class="footer"><div class="wrap footer-grid"><div><strong>ERIK THE WRITER</strong><p>Stories with shadows. A community with heart.</p></div><div><a href="/writing/">Writing</a><a href="/streaming/">Streaming</a><a href="/journal/">Journal</a></div><div><a href="/media/">Media</a><a href="/shop/">Shop</a>{socials.length>0&&<div class="social-block"><div class="social-title">Follow &amp; Connect</div><div class="social-links">{socials.map(social=><a class="social-link" href={social.url} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${social.label} (opens in a new tab)`}>{social.label}<span aria-hidden="true">↗</span></a>)}</div></div>}</div></div><div class="wrap fine"><span>© {new Date().getFullYear()} Erik the Writer. All rights reserved. Purchases are completed on external retailer websites.</span><span class="imprint-credit"><img src={imprintLogo} alt="" loading="lazy" width="36" height="36"/> Published under the Eleven Candles Press imprint.</span></div></footer></body></html>
<style is:global>
:root{color-scheme:dark;--bg:#141618;--panel:#202225;--panel2:#282a2c;--text:#f0e9dd;--muted:#c0b8aa;--copper:#c97737;--deep:#a64b16;--gold:#b49a6a;--line:#3c3935}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--text);font-family:'DM Sans',Arial,sans-serif;line-height:1.7}a{color:inherit}a:focus-visible,button:focus-visible{outline:3px solid var(--copper);outline-offset:3px}.skip{position:absolute;left:-9999px;top:5px}.skip:focus{left:10px;z-index:10;background:white;color:black;padding:8px}.wrap{width:min(1120px,calc(100% - 40px));margin:auto}.site-header{border-bottom:1px solid var(--line);background:#151719eD;position:sticky;top:0;z-index:5;backdrop-filter:blur(12px)}.header-content{display:flex;justify-content:space-between;gap:30px;align-items:center;padding:17px 0}.brand{text-decoration:none;font-family:'Libre Baskerville',serif;letter-spacing:.055em;font-size:1.1rem;font-weight:bold;line-height:1.1;white-space:nowrap}.brand span{color:var(--copper)}.brand small{display:block;font:500 .6rem 'DM Sans',sans-serif;color:var(--gold);letter-spacing:.19em;margin-top:8px}nav{display:flex;gap:clamp(9px,1.7vw,27px);flex-wrap:wrap}nav a{text-decoration:none;color:var(--muted);font-size:.85rem}nav a:hover,nav a[aria-current=page]{color:var(--copper)}h1,h2,h3{font-family:'Libre Baskerville',Georgia,serif;line-height:1.2;letter-spacing:-.025em}h1{font-size:clamp(2.6rem,6vw,5.2rem);margin:0 0 18px}h2{font-size:clamp(1.8rem,3.3vw,2.8rem)}h3{font-size:1.3rem}.eyebrow{text-transform:uppercase;letter-spacing:.21em;font-size:.72rem;font-weight:700;color:var(--gold)}.lead{font-size:clamp(1.06rem,1.8vw,1.25rem);color:var(--muted);max-width:660px}.section{padding:76px 0}.section.alt{background:#191b1d}.hero{padding:110px 0 105px;position:relative;overflow:hidden;background:radial-gradient(ellipse at 82% 48%,#56321e80,transparent 42%),linear-gradient(130deg,#181a1c,#111315)}.hero:after{content:'';position:absolute;inset:auto 0 0;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.55}.hero .wrap{position:relative;z-index:1}.hero p{max-width:630px}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:30px}.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;text-decoration:none;padding:12px 20px;background:var(--deep);color:#fff;border:1px solid #ca7237;border-radius:4px;font-weight:700;font-size:.88rem}.btn:hover{background:#ba6025}.btn.outline{background:transparent;border-color:#82705b;color:var(--text)}.btn.outline:hover{background:var(--panel)}.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}.card{background:var(--panel);border:1px solid var(--line);border-radius:7px;padding:27px;min-width:0}.card:hover{border-color:#8a5a39}.card p{color:var(--muted)}.card a:not(.btn){color:var(--copper)}.card .eyebrow{font-size:.67rem}.card h3{margin-top:9px}.card img{width:100%;aspect-ratio:16/10;object-fit:cover;border-radius:4px}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:28px}.section-heading h2{margin:7px 0 0}.section-heading>a{color:var(--copper)}.banner{border-left:3px solid var(--copper);padding:18px 25px;background:#252320}.banner p{margin:0;color:var(--muted)}.footer{border-top:1px solid var(--line);background:#111315;padding:45px 0 15px}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:20px}.footer strong{font-family:'Libre Baskerville',serif}.footer p,.fine{color:#a8a091;font-size:.83rem}.footer a{display:block;color:var(--muted);text-decoration:none;font-size:.86rem;margin-bottom:7px}.footer a:hover{color:var(--copper)}.fine{border-top:1px solid var(--line);margin-top:32px;padding-top:15px}.prose{max-width:760px}.prose p,.prose li{color:var(--muted)}.prose a{color:var(--copper)}.tag{font-size:.7rem;letter-spacing:.1em;text-transform:uppercase;color:var(--gold)}.product-links{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}.pill{border:1px solid #885e40;border-radius:3px;padding:7px 11px;text-decoration:none;font-size:.81rem;color:var(--text)}.pill:hover{background:#493123}.empty{padding:30px;border:1px dashed #665444;color:var(--muted)}@media(max-width:850px){.header-content{align-items:flex-start;flex-direction:column;gap:18px}.grid{grid-template-columns:repeat(2,minmax(0,1fr))}.hero{padding:85px 0}}@media(max-width:580px){.grid,.grid.two,.footer-grid{grid-template-columns:1fr}.section{padding:54px 0}.hero{padding:65px 0}.card{padding:21px}nav{gap:11px 15px}.section-heading{align-items:start;flex-direction:column}}
.social-block{margin-top:17px}.social-title{font-size:.7rem;color:var(--gold);font-weight:700;letter-spacing:.14em;text-transform:uppercase;margin-bottom:8px}.social-links{display:flex;flex-wrap:wrap;gap:7px}.footer .social-link{display:inline-flex;align-items:center;gap:5px;margin:0;padding:4px 9px;border:1px solid var(--line);border-radius:4px;font-size:.75rem;line-height:1.55;text-decoration:none}.footer .social-link:hover{border-color:var(--copper);color:var(--text)}.social-link span{color:var(--copper)}.fine{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px}.imprint-credit{display:inline-flex;align-items:center;gap:8px}.imprint-credit img{width:34px;height:34px;object-fit:contain}@media(max-width:580px){.imprint-credit{width:100%}}
</style>
